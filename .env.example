# SignalPulse RT Environment Configuration

# PostgreSQL Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/signalpulse"

# Redis server connection URL (for presence and pub/sub)
REDIS_URL="redis://127.0.0.1:6379"

# Giphy API Key for GIF & Sticker search (optional for testing)
GIPHY_API_KEY=""

# Cryptographically strong secret key for JWT session signing (Required in production)
# Generate via: openssl rand -hex 32
JWT_SECRET=""

# Ports (Optional defaults: 3000 for Next.js, 3001 for WebSocket server)
PORT=3000
WS_PORT=3001

# Message Rate Limiting Policy (Sliding-window: 100 messages / 60 seconds per authenticated user)
MESSAGE_RATE_LIMIT=100
MESSAGE_RATE_WINDOW_SECONDS=60
MESSAGE_RATE_LIMIT_ENABLED=true
